{
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "executive_dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "tni_sale.html",
      "use": "@vercel/static"
    },
    {
      "src": "sale.html",
      "use": "@vercel/static"
    },
    {
      "src": "checklist.html",
      "use": "@vercel/static"
    },
    {
      "src": "asset_audit.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/collector.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/search_bot.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/attendance.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/refuel_collector.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/bi_data.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/plan_dep.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/task_notes.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/construction.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/solution_clear.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/cable_bot.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/asset_audit.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/index.html",
      "dest": "index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/executive_dashboard.html",
      "dest": "executive_dashboard.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/tni_sale.html",
      "dest": "tni_sale.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/sale",
      "dest": "sale.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/sale.html",
      "dest": "sale.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/checklist",
      "dest": "checklist.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/checklist.html",
      "dest": "checklist.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/asset",
      "dest": "asset_audit.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/asset_audit.html",
      "dest": "asset_audit.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    },
    {
      "src": "/api/index",
      "dest": "api/index.py"
    },
    {
      "src": "/api/collector",
      "dest": "api/collector.py"
    },
    {
      "src": "/api/search_bot",
      "dest": "api/search_bot.py"
    },
    {
      "src": "/api/attendance",
      "dest": "api/attendance.py"
    },
    {
      "src": "/api/refuel_collector",
      "dest": "api/refuel_collector.py"
    },
    {
      "src": "/api/bi_data",
      "dest": "api/bi_data.py"
    },
    {
      "src": "/api/plan_dep",
      "dest": "api/plan_dep.py"
    },
    {
      "src": "/api/task_notes",
      "dest": "api/task_notes.py"
    },
    {
      "src": "/api/construction",
      "dest": "api/construction.py"
    },
    {
      "src": "/api/solution_clear",
      "dest": "api/solution_clear.py"
    },
    {
      "src": "/api/cable_bot",
      "dest": "api/cable_bot.py"
    },
    {
      "src": "/api/asset_audit",
      "dest": "api/asset_audit.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      }
    }
  ]
}
